{
  "name": "budget-personnel",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Application locale de gestion de budget personnel en FCFA (XOF)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
