    "write-excel-file": "^2.3.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.0.0",
